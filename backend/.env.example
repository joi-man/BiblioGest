# Copiar a .env y completar. Nunca subir .env a git.
SECRETO_JWT=cambiar-en-produccion

# Correo para recuperacion de contrasena (Gmail gratis)
# Requiere verificacion en 2 pasos y una "Contrasena de aplicacion":
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=tu_cuenta@gmail.com
SMTP_CLAVE=contrasena_de_aplicacion_de_16_letras
SMTP_REMITENTE=tu_cuenta@gmail.com

CODIGO_RESET_EXPIRACION_MINUTOS=15
CODIGO_RESET_MAX_INTENTOS=5

# Produccion (Render + Neon)
# BASE_DATOS_URL=postgresql+psycopg://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require
# EJECUTAR_MIGRACIONES=1
# ORIGENES_PERMITIDOS=https://tu-app.vercel.app
